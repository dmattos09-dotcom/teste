# ===== Meta / Instagram =====
# Segredo do app do Instagram (Meta for Developers > seu app > Instagram > Configuração da API com login do Instagram > "Chave secreta do app do Instagram")
IG_APP_SECRET=
# Token de acesso de longa duração da sua conta (gerado no painel do app)
IG_ACCESS_TOKEN=
# Uma senha qualquer que você inventa e cola no painel da Meta ao configurar o webhook
WEBHOOK_VERIFY_TOKEN=
# Versão da Graph API
IG_API_VERSION=v23.0

# ===== Painel =====
# Senha para entrar no painel /
ADMIN_PASSWORD=

# ===== Banco (Upstash Redis via Vercel Marketplace) =====
# Ao conectar o Upstash na Vercel, essas variáveis são criadas sozinhas
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ===== Cron de renovação do token =====
# Outra senha que você inventa (a Vercel usa para chamar a renovação semanal do token)
CRON_SECRET=
